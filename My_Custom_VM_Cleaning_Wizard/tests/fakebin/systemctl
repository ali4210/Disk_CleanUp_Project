#!/usr/bin/env bash
# Fake systemctl for tests/run-tests.sh. Never touches real systemd units —
# tracks unit "active"/"inactive" state as files under $FAKE_SYSTEMCTL_STATE.
set -euo pipefail
STATE_DIR="${FAKE_SYSTEMCTL_STATE:?FAKE_SYSTEMCTL_STATE must be set}"
mkdir -p "$STATE_DIR"

args=("$@")
# Drop leading flags like --user so the subcommand is args[0].
while [[ "${args[0]:-}" == --* ]]; do args=("${args[@]:1}"); done
cmd="${args[0]:-}"
args=("${args[@]:1}")

case "$cmd" in
    daemon-reload) exit 0 ;;
    stop)
        for u in "${args[@]}"; do [[ "$u" == --* ]] || echo inactive > "$STATE_DIR/$u"; done
        exit 0 ;;
    start)
        for u in "${args[@]}"; do [[ "$u" == --* ]] || echo active > "$STATE_DIR/$u"; done
        exit 0 ;;
    enable)
        for u in "${args[@]}"; do [[ "$u" == --* ]] || echo active > "$STATE_DIR/$u"; done
        exit 0 ;;
    is-active)
        unit=""
        for a in "${args[@]}"; do [[ "$a" == --* ]] || unit="$a"; done
        [[ -f "$STATE_DIR/$unit" && "$(cat "$STATE_DIR/$unit")" == "active" ]] && exit 0 || exit 1 ;;
    cat) exit 0 ;;
    is-system-running) echo running; exit 0 ;;
    *) exit 0 ;;
esac
